{
  "theme": "default",
  "html": true,
  "markdown": {
    "breaks": true,
    "typographer": true
  },
  "engine": "node",
  "script": [],
  "stylesheet": [],
  "css": `
    :root {
      --color-background: #ffffff;
      --color-foreground: #333333;
      --color-highlight: #0066cc;
      --color-accent: #00a86b;
      --color-secondary: #666666;
    }

    section {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      font-size: 28px;
      padding: 60px;
      background: #ffffff;
    }

    section.lead {
      background: linear-gradient(135deg, #0066cc 0%, #003366 100%);
      color: #ffffff;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    h1 {
      color: #0066cc;
      font-size: 54px;
      font-weight: 700;
      margin: 0 0 30px 0;
    }

    section.lead h1 {
      color: #ffffff;
    }

    h2 {
      color: #003366;
      font-size: 42px;
      font-weight: 700;
      margin: 20px 0 30px 0;
      border-bottom: 3px solid #0066cc;
      padding-bottom: 15px;
    }

    h3 {
      color: #0066cc;
      font-size: 32px;
      font-weight: 600;
      margin: 15px 0;
    }

    p {
      font-size: 28px;
      line-height: 1.6;
      color: #333333;
      margin: 15px 0;
    }

    ul, ol {
      font-size: 26px;
      line-height: 1.8;
      margin: 15px 0;
    }

    li {
      margin: 10px 0;
      color: #333333;
    }

    strong {
      color: #0066cc;
      font-weight: 700;
    }

    table {
      font-size: 22px;
      margin: 20px 0;
      border-collapse: collapse;
    }

    th {
      background: #0066cc;
      color: #ffffff;
      padding: 12px;
      text-align: left;
      font-weight: 700;
    }

    td {
      padding: 10px 12px;
      border-bottom: 1px solid #e0e0e0;
    }

    tr:nth-child(even) {
      background: #f5f5f5;
    }

    code {
      background: #f5f5f5;
      color: #d63384;
      padding: 2px 6px;
      border-radius: 3px;
      font-family: 'Courier New', monospace;
      font-size: 22px;
    }

    pre {
      background: #f5f5f5;
      padding: 15px;
      border-radius: 5px;
      border-left: 4px solid #0066cc;
      overflow-x: auto;
      margin: 15px 0;
    }

    pre code {
      background: transparent;
      color: #333333;
      padding: 0;
    }

    blockquote {
      border-left: 4px solid #0066cc;
      padding: 15px 20px;
      margin: 15px 0;
      background: #f0f5ff;
      color: #003366;
      font-size: 24px;
    }

    footer {
      position: fixed;
      bottom: 20px;
      right: 30px;
      font-size: 18px;
      color: #999999;
    }
  `
}
